# ─────────────────────────────────────────────────────────────
#  pyproject.toml  —  house style baseline  (Python 3.12+)
#  Toolchain: uv · ruff · ty · pytest · pydantic-settings
#  Formatter authority: ruff  (double-quotes, 120-char, lf)
# ─────────────────────────────────────────────────────────────

# ── Build ────────────────────────────────────────────────────
[build-system]
requires      = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src"]

# ── Project metadata ─────────────────────────────────────────
[project]
name            = "your-project"
version         = "0.1.0"
description     = "Short description — one sentence, no trailing period"
readme          = "README.md"
requires-python = ">=3.12"
license         = { text = "MIT" }

dependencies = [
    # ── Runtime ───────────────────────────────────────────────
    # Add approved dependencies here (plan-phase approval required).
    # Never install arbitrary packages. Never add deps in act-phase.
    "pydantic>=2.7",
    "pydantic-settings>=2.3",
    "structlog>=24.1",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "pytest-asyncio>=0.23",
]

[project.scripts]
# Map operator-facing CLI commands here.
# your-project = "your_pkg.cli:main"

# ── uv workspace ─────────────────────────────────────────────
[tool.uv]
package = true

# ── Ruff: formatter ──────────────────────────────────────────
[tool.ruff]
target-version  = "py312"
line-length     = 120
extend-exclude  = [
    ".devcontainer",
    "datasets",
    "models",
    ".venv",
]

[tool.ruff.format]
quote-style                = "double"
indent-style               = "space"
line-ending                = "lf"
docstring-code-format      = true
skip-magic-trailing-comma  = false

# ── Ruff: linter ─────────────────────────────────────────────
[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "W",    # pycodestyle warnings
    "F",    # pyflakes
    "I",    # isort
    "B",    # flake8-bugbear
    "C90",  # mccabe complexity
    "UP",   # pyupgrade
    "SIM",  # flake8-simplify
    "RET",  # flake8-return
    "RUF",  # ruff-specific
    "N",    # pep8-naming
    "A",    # flake8-builtins
    "ARG",  # unused arguments
    "PTH",  # use pathlib
    "LOG",  # flake8-logging
    "G",    # flake8-logging-format
    "TRY",  # tryceratops
    "DTZ",  # datetime timezone
    "D",    # pydocstyle
]
ignore = [
    "D100",   # module-level docstrings not required
    "D104",   # package __init__ docstrings not required
    "D105",   # magic method docstrings not required
    "D107",   # __init__ docstrings not required
    "D203",   # conflicts with D211
    "D213",   # conflicts with D212
    "TRY003", # allow descriptive exception messages inline
    "TRY301", # allow raise inside try when idiomatic
]
fixable   = ["ALL"]
unfixable = []
preview   = true

[tool.ruff.lint.pydocstyle]
convention = "numpy"  # optimised for IPython ? help() display

[tool.ruff.lint.mccabe]
max-complexity = 10   # nudge to decompose; not a hard error in editor

[tool.ruff.lint.isort]
force-single-line       = false
combine-as-imports      = true
split-on-trailing-comma = true
known-first-party       = ["your_pkg"]

# ── Per-file lint relaxations ─────────────────────────────────
[tool.ruff.lint.per-file-ignores]
# tests: no docstrings, loose typing, assert OK, magic values OK
"tests/**/*.py"         = ["D", "ANN", "ARG", "S101", "PLR2004"]
"**/test_*.py"          = ["D", "ANN", "ARG", "S101", "PLR2004"]
# scripts & notebooks: no docstrings, loose annotations
"scripts/**/*.py"       = ["D", "ANN"]
"notebooks/**/*.py"     = ["D", "ANN", "T201"]
# __init__ re-exports: F401 (unused import) expected
"src/**/__init__.py"    = ["F401"]

# ── pytest ───────────────────────────────────────────────────
[tool.pytest.ini_options]
minversion  = "8.0"
addopts     = [
    "--strict-markers",
    "--strict-config",
    "--import-mode=importlib",
    "--tb=short",
]
testpaths   = ["tests", "src"]
pythonpath  = ["src"]
xfail_strict = true
filterwarnings = [
    "error",
    "ignore::DeprecationWarning:pkg_resources",
]
markers = [
    "integration: integration tests — run in ci/premerge",
    "slow: slow tests — run in ci/premerge",
    "gpu: requires CUDA GPU — run in ci/predeploy",
]

# ── Coverage ─────────────────────────────────────────────────
[tool.coverage.run]
source  = ["src"]
branch  = true
omit    = ["**/test_*.py", "**/conftest.py"]

[tool.coverage.report]
skip_empty    = true
show_missing  = true
fail_under    = 60

# ── ty (Astral) ───────────────────────────────────────────────
[tool.ty.src]
include = ["src", "scripts"]
exclude = ["datasets", "models", "notebooks", ".devcontainer", ".venv"]

[tool.ty.environment]
python = ".venv"

[tool.ty.rules]
# Pragmatic posture: editor stays fast; stricter checks live in ci/premerge.py
division-by-zero            = "error"
possibly-unbound            = "warn"
missing-argument            = "warn"
invalid-return-type         = "warn"
unknown-member-type         = "ignore"  # polars/torch stubs imperfect
missing-return               = "warn"

[[tool.ty.overrides]]
# Relax everything in tests — mocking, monkeypatching, fixtures
include = ["tests/**/*.py", "**/test_*.py", "**/conftest.py"]
[tool.ty.overrides.rules]
unknown-argument        = "ignore"
missing-argument        = "ignore"
invalid-argument-type   = "ignore"
invalid-return-type     = "ignore"
